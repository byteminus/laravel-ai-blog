{
    "name": "byteminus/laravel-ai-blog",
    "description": "Laravel blog package with built-in SEO scoring, AI drafting (laravel/ai) and an MCP server so Claude and ChatGPT can write to it. Headless by default.",
    "keywords": ["laravel", "blog", "blogging", "laravel-blog", "ai", "seo", "mcp", "model-context-protocol", "cms", "headless", "json-ld", "structured-data", "rss", "claude", "chatgpt"],
    "homepage": "https://byteminus.github.io/laravel-ai-blog/",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Byte Minus",
            "homepage": "https://github.com/byteminus",
            "role": "Organization"
        },
        {
            "name": "Mr Hawk",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/byteminus/laravel-ai-blog/issues",
        "source": "https://github.com/byteminus/laravel-ai-blog"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.5||^8.0",
        "guzzlehttp/psr7": "^2.4",
        "illuminate/contracts": "^10.0||^11.0||^12.0||^13.0",
        "illuminate/http": "^10.0||^11.0||^12.0||^13.0",
        "league/commonmark": "^2.0",
        "spatie/laravel-package-tools": "^1.14",
        "symfony/html-sanitizer": "^6.1||^7.0||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.0",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "pestphp/pest": "^2.0||^3.0||^4.0",
        "pestphp/pest-plugin-laravel": "^2.0||^3.0||^4.0"
    },
    "suggest": {
        "laravel/ai": "Enables the AI editor, brief-to-draft, semantic linking and refresh features (^1.0).",
        "ext-gd": "Converts images stored with the upload-media MCP tool to WebP (needs WebP support).",
        "laravel/mcp": "Exposes the blog to Claude, ChatGPT, Claude Code and other agents over MCP (^1.0, Laravel 12.41+).",
        "spatie/laravel-sitemap": "Adds posts to your XML sitemap automatically."
    },
    "autoload": {
        "psr-4": {
            "ByteMinus\\AiBlog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ByteMinus\\AiBlog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ByteMinus\\AiBlog\\AiBlogServiceProvider"
            ],
            "aliases": {
                "AiBlog": "ByteMinus\\AiBlog\\Facades\\AiBlog"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
